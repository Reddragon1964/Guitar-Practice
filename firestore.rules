rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPractice(data) {
      return data.keys().hasAll(['userId', 'songTitle', 'difficulty', 'correctNotes', 'totalNotes', 'accuracy', 'speed', 'date', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'songTitle', 'difficulty', 'correctNotes', 'totalNotes', 'accuracy', 'speed', 'date', 'createdAt', 'duration', 'isPartial', 'isShortVersion', 'isTestSession', 'score', 'note', 'difficultyRating']) &&
             (!('duration' in data) || data.duration is number) &&
             (!('isPartial' in data) || data.isPartial is bool) &&
             (!('isShortVersion' in data) || data.isShortVersion is bool) &&
             (!('isTestSession' in data) || data.isTestSession is bool) &&
             (!('score' in data) || (data.score is number && data.score >= 0)) &&
             (!('note' in data) || data.note is string) &&
             (!('difficultyRating' in data) || (data.difficultyRating is number && data.difficultyRating >= 1 && data.difficultyRating <= 5)) &&
             data.userId == request.auth.uid &&
             data.songTitle is string && data.songTitle.size() > 0 && data.songTitle.size() <= 200 &&
             data.difficulty is number && data.difficulty >= 1 && data.difficulty <= 12 &&
             data.correctNotes is number &&
             data.totalNotes is number &&
             data.accuracy is number &&
             data.speed is number &&
             data.date is string &&
             data.createdAt is number;
    }

    match /practices/{practiceId} {
      allow get: if isSignedIn() && isValidId(practiceId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(practiceId) && 
                    isValidPractice(incoming());
                    
      allow update: if isSignedIn() && 
                    isValidId(practiceId) &&
                    existing().userId == request.auth.uid &&
                    isValidPractice(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isSignedIn() && isValidId(practiceId) && existing().userId == request.auth.uid;
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['userId', 'title', 'targetDate', 'achieved', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'title', 'targetDate', 'achieved', 'createdAt', 'songTitle']) &&
             (!('songTitle' in data) || data.songTitle is string) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.targetDate is string &&
             data.achieved is bool &&
             data.createdAt is number;
    }

    match /goals/{goalId} {
      allow get: if isSignedIn() && isValidId(goalId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(goalId) && 
                    isValidGoal(incoming());
                    
      allow update: if isSignedIn() && 
                    isValidId(goalId) &&
                    existing().userId == request.auth.uid &&
                    isValidGoal(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isSignedIn() && isValidId(goalId) && existing().userId == request.auth.uid;
    }

    function isValidSong(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'title', 'createdAt', 'retired']) &&
             (!('retired' in data) || data.retired is bool) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.createdAt is number;
    }

    match /songs/{songId} {
      allow get: if isSignedIn() && isValidId(songId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(songId) && 
                    isValidSong(incoming());
                    
      allow update: if isSignedIn() && 
                    isValidId(songId) &&
                    existing().userId == request.auth.uid &&
                    isValidSong(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isSignedIn() && isValidId(songId) && existing().userId == request.auth.uid;
    }

    function isValidDailyUsage(data) {
      return data.keys().hasAll(['userId', 'date', 'minutes', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'date', 'minutes', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.date is string &&
             data.minutes is number &&
             data.updatedAt is number;
    }

    match /dailyUsage/{usageId} {
      allow get: if isSignedIn() && isValidId(usageId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(usageId) && 
                    isValidDailyUsage(incoming());
                    
      allow update: if isSignedIn() && 
                    isValidId(usageId) &&
                    existing().userId == request.auth.uid &&
                    isValidDailyUsage(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().date == existing().date;
                    
      allow delete: if isSignedIn() && isValidId(usageId) && existing().userId == request.auth.uid;
    }

    function isValidWeeklyGoal(data) {
      return data.keys().hasAll(['userId', 'title', 'targetMinutes', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'title', 'targetMinutes', 'createdAt', 'songTitle']) &&
             (!('songTitle' in data) || (data.songTitle is string && data.songTitle.size() <= 200)) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.targetMinutes is number && data.targetMinutes >= 1 && data.targetMinutes <= 10080 &&
             data.createdAt is number;
    }

    match /weeklyGoals/{goalId} {
      allow get: if isSignedIn() && isValidId(goalId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(goalId) && 
                    isValidWeeklyGoal(incoming());
                    
      allow update: if isSignedIn() && 
                    isValidId(goalId) &&
                    existing().userId == request.auth.uid &&
                    isValidWeeklyGoal(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isSignedIn() && isValidId(goalId) && existing().userId == request.auth.uid;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'text', 'personaId', 'model', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'role', 'text', 'personaId', 'model', 'createdAt']) &&
             data.userId == request.auth.uid &&
             (data.role == 'user' || data.role == 'model') &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 10000 &&
             data.personaId is string && data.personaId.size() <= 100 &&
             data.model is string && data.model.size() <= 100 &&
             data.createdAt is number;
    }

    match /chatMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                    isValidId(messageId) &&
                    isValidChatMessage(incoming());

      allow update: if isSignedIn() &&
                    isValidId(messageId) &&
                    existing().userId == request.auth.uid &&
                    isValidChatMessage(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;

      allow delete: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
    }
  }
}
